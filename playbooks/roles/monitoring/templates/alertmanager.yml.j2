global:
  resolve_timeout: 5m

route:
  group_by: ['alertname', 'severity']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  receiver: discord
  routes:
    - matchers:
        - severity = critical
      repeat_interval: 1h

receivers:
  - name: discord
    discord_configs:
      - webhook_url: "https://discord.com/api/webhooks/{{ watchtower_discord_id }}/{{ watchtower_discord_token }}"
        send_resolved: true
