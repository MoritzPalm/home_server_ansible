{% raw %}
{
  "description": "Container logs collected by Promtail and stored in Loki",
  "editable": true,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "templating": {
    "list": [
      {
        "name": "container",
        "label": "Container",
        "type": "query",
        "datasource": {"type": "loki", "uid": "loki"},
        "query": {"label": "container", "stream": "", "type": 1},
        "refresh": 2,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "current": {"text": "All", "value": "$__all"}
      },
      {
        "name": "search",
        "label": "Search",
        "type": "textbox",
        "query": "",
        "current": {"text": "", "value": ""}
      }
    ]
  },
  "panels": [
    {
      "datasource": {"type": "loki", "uid": "loki"},
      "description": "Log lines per second per container.",
      "fieldConfig": {
        "defaults": {
          "custom": {"lineWidth": 1, "fillOpacity": 30, "showPoints": "never", "stacking": {"mode": "normal", "group": "A"}},
          "unit": "logs"
        },
        "overrides": []
      },
      "gridPos": {"h": 7, "w": 24, "x": 0, "y": 0},
      "id": 1,
      "options": {
        "legend": {"calcs": ["sum"], "displayMode": "table", "placement": "right"},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [{
        "datasource": {"type": "loki", "uid": "loki"},
        "expr": "sum by (container) (rate({container=~\"$container\"} |~ \"(?i)$search\" [$__auto]))",
        "legendFormat": "{{container}}",
        "refId": "A"
      }],
      "title": "Log Rate by Container",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "loki", "uid": "loki"},
      "description": "Rate of lines matching error/warn/fatal/exception per container.",
      "fieldConfig": {
        "defaults": {
          "color": {"fixedColor": "red", "mode": "fixed"},
          "custom": {"lineWidth": 1, "fillOpacity": 20, "showPoints": "never"},
          "unit": "logs"
        },
        "overrides": []
      },
      "gridPos": {"h": 7, "w": 24, "x": 0, "y": 7},
      "id": 2,
      "options": {
        "legend": {"calcs": ["sum"], "displayMode": "table", "placement": "right"},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [{
        "datasource": {"type": "loki", "uid": "loki"},
        "expr": "sum by (container) (rate({container=~\"$container\"} |~ \"(?i)(error|warn|fatal|exception|panic)\" [$__auto]))",
        "legendFormat": "{{container}}",
        "refId": "A"
      }],
      "title": "Error/Warning Rate by Container",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 16, "w": 24, "x": 0, "y": 14},
      "id": 3,
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [{
        "datasource": {"type": "loki", "uid": "loki"},
        "expr": "{container=~\"$container\"} |~ \"(?i)$search\"",
        "refId": "A"
      }],
      "title": "Logs",
      "type": "logs"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["logs", "loki"],
  "time": {"from": "now-1h", "to": "now"},
  "timezone": "browser",
  "title": "Container Logs",
  "uid": "container-logs",
  "version": 1
}
{% endraw %}
