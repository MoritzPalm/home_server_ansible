global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    monitor: mserver

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - alertmanager:9093

rule_files:
  - '/etc/prometheus/rules/*.yml'

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ['localhost:9090']

  - job_name: node-exporter
    static_configs:
      - targets: ['node-exporter:9100']
    relabel_configs:
      - source_labels: [__address__]
        target_label: instance
        replacement: mserver

  - job_name: cadvisor
    static_configs:
      - targets: ['cadvisor:8080']
    metric_relabel_configs:
      - source_labels: [__name__]
        regex: 'container_(cpu|memory|network|fs|oom|spec|start_time|processes|tasks_state).*|container_last_seen|machine_.*'
        action: keep

  - job_name: smartctl
    static_configs:
      - targets: ['smartctl-exporter:9902']

  - job_name: loki
    static_configs:
      - targets: ['loki:3100']

  - job_name: promtail
    static_configs:
      - targets: ['promtail:9080']

  - job_name: alertmanager
    static_configs:
      - targets: ['alertmanager:9093']

  - job_name: grafana
    static_configs:
      - targets: ['grafana:3000']

  # --- public ingress -------------------------------------------------------
  # All four are reached over the 'internal' docker network; none of these
  # metrics ports is published to the host.

  # Traefik serves metrics on its internal 'traefik' entrypoint, the same one
  # ping uses. This is not the dashboard, which is router-served on
  # traefik.{{ internal_domain }} and requires auth.
  - job_name: traefik
    static_configs:
      - targets: ['traefik:8080']

  - job_name: crowdsec
    static_configs:
      - targets: ['crowdsec:6060']

  - job_name: cloudflared
    static_configs:
      - targets: ['cloudflared:2000']

  - job_name: authentik
    static_configs:
      - targets: ['authentik_server:9300']
