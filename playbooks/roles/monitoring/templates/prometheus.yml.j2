global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    monitor: mserver

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - alertmanager:9093

rule_files:
  - '/etc/prometheus/rules/*.yml'

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ['localhost:9090']

  - job_name: node-exporter
    static_configs:
      - targets: ['node-exporter:9100']
    relabel_configs:
      - source_labels: [__address__]
        target_label: instance
        replacement: mserver

  - job_name: cadvisor
    static_configs:
      - targets: ['cadvisor:8080']
    metric_relabel_configs:
      - source_labels: [__name__]
        regex: 'container_(cpu|memory|network|fs|oom).*|container_last_seen'
        action: keep
      - source_labels: [container_label_com_docker_compose_project]
        regex: ''
        action: drop

  - job_name: smartctl
    static_configs:
      - targets: ['smartctl-exporter:9902']

  - job_name: loki
    static_configs:
      - targets: ['loki:3100']

  - job_name: alertmanager
    static_configs:
      - targets: ['alertmanager:9093']

  - job_name: grafana
    static_configs:
      - targets: ['grafana:3000']
