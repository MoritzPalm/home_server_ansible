# Managed by Ansible (roles/firewall) — edits on the host are overwritten.
#
# Plex does not pass through Traefik, so CrowdSec sees none of its traffic. This
# jail is the only intrusion detection on TCP {{ wan_allowed_container_ports | map(attribute='port') | join(', ') }}.

[plex-auth]
enabled  = true
filter   = plex-auth
backend  = auto

# A symlink, not the real path: fail2ban splits the last space-separated token
# off a logpath as a head/tail modifier, and Plex's path has spaces in three
# directory names. Target: {{ plex_log_path }}
logpath  = {{ plex_log_link }}

maxretry = {{ plex_fail2ban_maxretry }}
findtime = {{ plex_fail2ban_findtime }}
bantime  = {{ plex_fail2ban_bantime }}

# Networks that legitimately produce 401s. Tailscale's CGNAT range is included
# because every admin path to this host runs over it. The Docker bridge range
# covers internal consumers such as multi-scrobbler.
ignoreip = 127.0.0.1/8 ::1 {{ lan_subnet }} 100.64.0.0/10 172.16.0.0/12

# Bans land in {{ firewall_ban_chain }}, which roles/firewall jumps to from
# DOCKER-USER. Stock iptables actions write to INPUT, which Docker bypasses.
action   = docker-user[name={{ plex_fail2ban_name }}]
