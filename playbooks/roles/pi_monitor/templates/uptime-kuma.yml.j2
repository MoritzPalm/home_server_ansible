services:

  uptime-kuma:
    image: louislam/uptime-kuma:1
    container_name: uptime-kuma
    volumes:
      - {{ database_dir }}/uptime-kuma:/app/data
    ports:
      - {{ pi_tailscale_ip }}:{{ uptime_kuma_port }}:3001
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
