---
# Managed by Ansible (roles/identity) — edits on the host are overwritten.
#
# One proxy provider + application per forward-auth protected host, plus the
# embedded outpost that serves them. Applied automatically on file write.
#
# !Find looks up objects authentik ships by default, so this blueprint does not
# hardcode primary keys that differ between installs.
version: 1
metadata:
  name: homeserver-proxy-providers
  labels:
    blueprints.goauthentik.io/instantiate: "true"
entries:

{% for app in authentik_proxy_apps %}
  - model: authentik_providers_proxy.proxyprovider
    state: present
    id: provider-{{ app.slug }}
    identifiers:
      name: "{{ app.name }}"
    attrs:
      # forward_single = forward-auth for one hostname, which is what the
      # Traefik middleware expects. 'proxy' mode would make authentik itself
      # the reverse proxy, duplicating Traefik.
      mode: forward_single
      external_host: "https://{{ app.host }}"
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      # Sessions survive a browser restart but not indefinitely.
      access_token_validity: hours=24

  - model: authentik_core.application
    state: present
    identifiers:
      slug: {{ app.slug }}
    attrs:
      name: "{{ app.name }}"
      provider: !KeyOf provider-{{ app.slug }}
      meta_description: "{{ app.description | default('') }}"
      # Access is granted by binding groups below, not by this flag.
      policy_engine_mode: any
{% endfor %}

  # The embedded outpost ships with authentik; bind every proxy provider to it
  # so no separate outpost container is needed.
  - model: authentik_outposts.outpost
    state: present
    identifiers:
      name: authentik Embedded Outpost
    attrs:
      type: proxy
      providers:
{% for app in authentik_proxy_apps %}
        - !KeyOf provider-{{ app.slug }}
{% endfor %}

{% for app in authentik_proxy_apps %}
{% for group in app.groups | default([]) %}
  # Restrict {{ app.name }} to the '{{ group }}' group. Without a binding an
  # application is open to every authenticated user.
  - model: authentik_policies.policybinding
    state: present
    identifiers:
      target: !Find [authentik_core.application, [slug, {{ app.slug }}]]
      group: !Find [authentik_core.group, [name, {{ group }}]]
      order: {{ loop.index0 }}
    attrs:
      enabled: true
{% endfor %}
{% endfor %}
