# Words that land in the unit slot because they sit between the amount and the
# food ("2 large eggs", "3 ripe bananas", "2 große Zwiebeln"). Treating them as
# Stück keeps the amount countable and lets the food alias see a plain name.
SIZE_WORDS = [
    'large', 'medium', 'small', 'big', 'ripe', 'whole', 'fresh', 'boneless', 'skinless',
    'groß', 'große', 'großes', 'großer', 'großen',
    'klein', 'kleine', 'kleines', 'kleiner', 'kleinen',
    'mittelgroße', 'mittelgroßes', 'mittelgroßer', 'mittlere',
    'reife', 'reifer', 'reifes', 'frische', 'frischer', 'frisches',
]

# NEVER_UNIT: the word after the amount is the start of the food, not a unit
# ("1 egg white", "2 red onions", "1 chicken breast"). Stück goes into the unit
# slot and the food alias then sees "egg white" or "red onions".
NEVER_UNITS = [
    'egg', 'chicken', 'red', 'green', 'yellow', 'white', 'sweet', 'spring', 'bell',
    'cherry', 'bay', 'vanilla', 'baby', 'lemon', 'lime', 'orange',
    'rote', 'roter', 'grüne', 'grüner', 'gelbe', 'gelber', 'weiße', 'weißer',
]

# TRANSPOSE_WORDS: swap the pair so the parser sees unit then food.
TRANSPOSE_WORDS = [
    ('garlic', 'clove'),
    ('garlic', 'cloves'),
]

