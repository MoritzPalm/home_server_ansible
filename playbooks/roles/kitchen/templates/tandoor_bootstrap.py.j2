def build_rules(known=None):
    """Expand the tables into Automation rows.

    `known` maps each exact name and plural in the space to the food or unit
    it resolves to. An alias whose source already resolves to its target would
    change nothing and is skipped; one that resolves to a stray food an import
    created is kept, so the stray stops being used. The same source under two
    targets is a mistake in the tables and raises.
    """
    known = known or {}
    rules = []
    seen = {}

    def add(type_, param_1, param_2=None, param_3=None):
        key = (type_, param_1.lower())
        if type_ == Automation.TRANSPOSE_WORDS:
            key += ((param_2 or '').lower(),)
        if key in seen:
            if seen[key] != (param_2, param_3):
                raise SystemExit(f'tandoor bootstrap: {type_} {param_1!r} maps to both {seen[key][0]!r} and {param_2!r}')
            return
        seen[key] = (param_2, param_3)
        rules.append({'type': type_, 'param_1': param_1, 'param_2': param_2, 'param_3': param_3})

    for target, variants in UNIT_ALIASES.items():
        for v in variants:
            if known.get(v, v) != target:
                add(Automation.UNIT_ALIAS, v, target)
    for w in SIZE_WORDS:
        add(Automation.UNIT_ALIAS, w, 'Stück')
    for w in NEVER_UNITS:
        add(Automation.NEVER_UNIT, w, 'Stück')
    for first, second in TRANSPOSE_WORDS:
        add(Automation.TRANSPOSE_WORDS, first, second)
    for target, variants in FOOD_ALIASES:
        for v in variants:
            if known.get(v, v) != target:
                add(Automation.FOOD_ALIAS, v, target)
    for r in EXTRA_AUTOMATIONS:
        add(r['type'], r['param_1'], r.get('param_2'), r.get('param_3'))
    return rules


# ---- seeding (everything above is data) ----


def target_space():
    with scopes_disabled():
        if SPACE_NAME:
            return Space.objects.get(name=SPACE_NAME)
        # SOCIAL_DEFAULT_ACCESS puts new OIDC users into Space.objects.first(),
        # so that is the shared household space.
        space = Space.objects.order_by('pk').first()
        if space is None:
            raise SystemExit('tandoor bootstrap: no space exists yet; log in once to create it')
        return space


def seed_open_data(space):
    response = safe_request('GET', OPEN_DATA_URL.format(OPEN_DATA_VERSION))
    response.raise_for_status()
    data = json.loads(response.content)

    # The importer only touches request.space and request.user.
    request = SimpleNamespace(space=space, user=space.created_by)
    importer = OpenDataImporter(request, data, update_existing=False, use_metric=True)
    steps = {
        'unit': importer.import_units,
        'category': importer.import_category,
        'property': importer.import_property,
        'store': importer.import_supermarket,
        'food': importer.import_food,
        'conversion': importer.import_conversion,
    }
    return {datatype: steps[datatype]().to_dict() for datatype in DATATYPES}


def seed_units(space):
    created = []
    for name, plural in EXTRA_UNITS:
        _, was_created = Unit.objects.get_or_create(space=space, name=name, defaults={'plural_name': plural})
        if was_created:
            created.append(name)
    return created


def known_names(space):
    """Exact name or plural -> the name it resolves to, for foods and units."""
    known = {}
    for model in (Food, Unit):
        for name, plural in model.objects.filter(space=space).values_list('name', 'plural_name'):
            known[name] = name
            if plural:
                known[plural] = name
    return known


def seed_automations(space, rules):
    created = updated = 0
    for r in rules:
        existing = Automation.objects.filter(space=space, type=r['type'], param_1__iexact=r['param_1'])
        if r['type'] == Automation.TRANSPOSE_WORDS:
            existing = existing.filter(param_2__iexact=r['param_2'] or '')
        existing = existing.first()
        name = f"{r['param_1']} → {r['param_2'] or ''}"[:128]
        if existing is None:
            Automation.objects.create(
                space=space, created_by=space.created_by, type=r['type'], name=name,
                param_1=r['param_1'], param_2=r['param_2'], param_3=r['param_3'],
            )
            created += 1
        elif (existing.param_2 or '') != (r['param_2'] or '') or (existing.param_3 or '') != (r['param_3'] or ''):
            existing.param_2 = r['param_2']
            existing.param_3 = r['param_3']
            existing.save()
            updated += 1
    return {'created': created, 'updated': updated}


def missing_targets(space, rules):
    """Alias targets that are not a food or unit in the space.

    Not fatal: the parser would create the target name on first use. But it
    means a typo in the tables, or open data that renamed something.
    """
    foods = set(Food.objects.filter(space=space).values_list('name', flat=True))
    units = set(Unit.objects.filter(space=space).values_list('name', flat=True))
    missing = set()
    for r in rules:
        if r['type'] == Automation.FOOD_ALIAS and r['param_2'] not in foods:
            missing.add(r['param_2'])
        if r['type'] == Automation.UNIT_ALIAS and r['param_2'] not in units:
            missing.add(r['param_2'])
    return sorted(missing)


space = target_space()
with scope(space=space), transaction.atomic():
    open_data = seed_open_data(space)
    units = seed_units(space)
    rules = build_rules(known_names(space))
    automations = seed_automations(space, rules)
    automations['missing_targets'] = missing_targets(space, rules)

changed = (
    any(r['total_created'] or r['total_updated'] for r in open_data.values())
    or bool(units)
    or bool(automations['created'] or automations['updated'])
)
print('TANDOOR_BOOTSTRAP_RESULT ' + json.dumps({
    'changed': changed,
    'space': space.name,
    'open_data_version': OPEN_DATA_VERSION,
    'open_data': open_data,
    'units_created': units,
    'rules': len(rules),
    'automations': automations,
}, ensure_ascii=False))
