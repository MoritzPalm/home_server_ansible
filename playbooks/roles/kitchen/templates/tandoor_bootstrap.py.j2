# Managed by Ansible (roles/kitchen). Piped into `manage.py shell` inside the
# tandoor container; never written to disk on the host.
#
# Seeds a space with Tandoor's open data (units, supermarket categories,
# nutrition property types, stores, foods, unit conversions), the English
# measuring units the open data lacks, and the unit rules below. Safe to
# re-run: existing objects are matched by open-data slug or name and left
# alone, so hand edits in the UI survive.
#
# The last line of output is `TANDOOR_BOOTSTRAP_RESULT {json}`; the task reads
# `changed` from it.

import json
from types import SimpleNamespace

from django.db import transaction
from django_scopes import scope, scopes_disabled

from cookbook.helper.HelperFunctions import safe_request
from cookbook.helper.open_data_importer import OpenDataImporter
from cookbook.models import Automation, Space, Unit

OPEN_DATA_VERSION = {{ tandoor_open_data_version | default('de') | to_json }}
OPEN_DATA_URL = 'https://raw.githubusercontent.com/TandoorRecipes/open-tandoor-data/main/build/{}.json'
SPACE_NAME = {{ tandoor_bootstrap_space | default('') | to_json }}

# Rules from the inventory, appended to the generated ones. Same shape:
# {'type': 'UNIT_ALIAS', 'param_1': 'Msp.', 'param_2': 'Prise'}.
EXTRA_AUTOMATIONS = json.loads({{ tandoor_extra_automations | default([]) | to_json | to_json }})

# Order matters: foods reference units, categories and property types by slug,
# and conversions reference foods and units.
DATATYPES = ['unit', 'category', 'property', 'store', 'food', 'conversion']

# ---------------------------------------------------------------------------
# Unit rules
#
# Tandoor's ingredient parser takes the token after the amount as the unit and
# looks it up in the space by exact, case-sensitive name. A miss creates a new
# unit with no base unit, and a unit without a base unit converts to nothing:
# no metric display, no nutrition. Food names are deliberately left alone, so
# German and English recipes keep their own foods; only units are normalised.
# Rules match case-insensitively and run before the lookup.
# ---------------------------------------------------------------------------

# Units the open data does not ship: the English measuring units, with the base
# unit Tandoor needs to convert them, and countable units in both languages.
# Tandoor's base-unit vocabulary is in cookbook/helper/unit_conversion_helper.py.
EXTRA_UNITS = [
    # name, plural, base unit
    ('tbsp', 'tbsp', 'tbsp'),
    ('tsp', 'tsp', 'tsp'),
    ('pint', 'pints', 'pint'),
    ('quart', 'quarts', 'quart'),
    ('pinch', 'pinches', None),
    ('can', 'cans', None),
    ('bottle', 'bottles', None),
    ('pcs', 'pcs', None),
    ('clove', 'cloves', None),
    ('bunch', 'bunches', None),
    ('slice', 'slices', None),
    ('package', 'packages', None),
    ('Zehe', 'Zehen', None),
    ('Bund', 'Bund', None),
    ('Scheibe', 'Scheiben', None),
    ('Packung', 'Packungen', None),
]

# UNIT_ALIAS: whole parsed unit -> existing unit name. English spellings go to
# the English unit, German spellings to the German one; Cup, oz, lb, g, kg, ml
# and l are shared because the open data names them that way already.
UNIT_ALIASES = {
    'EL': ['Esslöffel', 'Eßlöffel', 'EL.', 'Essl.'],
    'TL': ['Teelöffel', 'TL.'],
    'tbsp': ['tbsps', 'tbsp.', 'tbs', 'tablespoon', 'tablespoons'],
    'tsp': ['tsps', 'tsp.', 'teaspoon', 'teaspoons'],
    'Cup': ['cup', 'cups', 'Tasse', 'Tassen'],
    'g': ['Gramm', 'gr', 'gr.', 'gram', 'grams'],
    'kg': ['Kilogramm', 'kilogram', 'kilograms', 'kilo', 'kilos'],
    'ml': ['Milliliter', 'milliliter', 'milliliters', 'millilitre', 'millilitres'],
    'l': ['Liter', 'liter', 'liters', 'litre', 'litres'],
    'oz': ['ounce', 'ounces', 'oz.'],
    'lb': ['lbs', 'pound', 'pounds', 'Pfund'],
    'pint': ['pints', 'pt'],
    'quart': ['quarts', 'qt'],
    'Stück': ['Stk', 'Stk.', 'St.'],
    'pcs': ['piece', 'pieces', 'pc'],
    'Prise': ['Prisen'],
    'pinch': ['pinches', 'dash', 'dashes'],
    'Dose': ['Dosen'],
    'can': ['cans', 'tin', 'tins'],
    'Flasche': ['Flaschen'],
    'bottle': ['bottles'],
    'Zehe': ['Zehen'],
    'clove': ['cloves'],
    'bunch': ['bunches'],
    'Scheibe': ['Scheiben'],
    'slice': ['slices'],
    'Packung': ['Packungen', 'Pck.', 'Pkg.'],
    'package': ['packages', 'pack', 'packs', 'packet', 'packets', 'pkg'],
}

# Words that land in the unit slot because they sit between the amount and the
# food ("2 large eggs", "2 große Zwiebeln"). Treating them as a piece unit keeps
# the amount countable and the food name clean.
SIZE_WORDS = {
    'pcs': ['large', 'medium', 'small', 'big', 'ripe', 'whole', 'fresh', 'boneless', 'skinless'],
    'Stück': ['groß', 'große', 'großes', 'großer', 'großen',
              'klein', 'kleine', 'kleines', 'kleiner', 'kleinen',
              'mittelgroße', 'mittelgroßes', 'mittelgroßer', 'mittlere',
              'reife', 'reifer', 'reifes', 'frische', 'frischer', 'frisches'],
}

# NEVER_UNIT: the word after the amount starts the food, it is not a unit
# ("1 egg white", "2 red onions", "1 chicken breast"). The piece unit goes
# into the unit slot and the food keeps the word.
NEVER_UNITS = {
    'pcs': ['egg', 'chicken', 'red', 'green', 'yellow', 'white', 'sweet', 'spring', 'bell',
            'cherry', 'bay', 'vanilla', 'baby', 'lemon', 'lime', 'orange'],
    'Stück': ['rote', 'roter', 'grüne', 'grüner', 'gelbe', 'gelber', 'weiße', 'weißer'],
}

# TRANSPOSE_WORDS: swap the pair so the parser sees unit then food.
TRANSPOSE_WORDS = [
    ('garlic', 'clove'),
    ('garlic', 'cloves'),
]


def build_rules(known=None):
    """Expand the tables into Automation rows.

    `known` maps each exact unit name and plural in the space to the unit it
    resolves to. An alias whose source already resolves to its target would
    change nothing and is skipped. The same source under two targets is a
    mistake in the tables and raises.
    """
    known = known or {}
    rules = []
    seen = {}

    def add(type_, param_1, param_2=None, param_3=None):
        key = (type_, param_1.lower())
        if type_ == Automation.TRANSPOSE_WORDS:
            key += ((param_2 or '').lower(),)
        if key in seen:
            if seen[key] != (param_2, param_3):
                raise SystemExit(f'tandoor bootstrap: {type_} {param_1!r} maps to both {seen[key][0]!r} and {param_2!r}')
            return
        seen[key] = (param_2, param_3)
        rules.append({'type': type_, 'param_1': param_1, 'param_2': param_2, 'param_3': param_3})

    for target, variants in UNIT_ALIASES.items():
        for v in variants:
            if known.get(v, v) != target:
                add(Automation.UNIT_ALIAS, v, target)
    for target, words in SIZE_WORDS.items():
        for w in words:
            add(Automation.UNIT_ALIAS, w, target)
    for target, words in NEVER_UNITS.items():
        for w in words:
            add(Automation.NEVER_UNIT, w, target)
    for first, second in TRANSPOSE_WORDS:
        add(Automation.TRANSPOSE_WORDS, first, second)
    for r in EXTRA_AUTOMATIONS:
        add(r['type'], r['param_1'], r.get('param_2'), r.get('param_3'))
    return rules


# ---- seeding (everything above is data) ----


def target_space():
    with scopes_disabled():
        if SPACE_NAME:
            return Space.objects.get(name=SPACE_NAME)
        # SOCIAL_DEFAULT_ACCESS puts new OIDC users into Space.objects.first(),
        # so that is the shared household space.
        space = Space.objects.order_by('pk').first()
        if space is None:
            raise SystemExit('tandoor bootstrap: no space exists yet; log in once to create it')
        return space


def seed_open_data(space):
    response = safe_request('GET', OPEN_DATA_URL.format(OPEN_DATA_VERSION))
    response.raise_for_status()
    data = json.loads(response.content)

    # The importer only touches request.space and request.user.
    request = SimpleNamespace(space=space, user=space.created_by)
    importer = OpenDataImporter(request, data, update_existing=False, use_metric=True)
    steps = {
        'unit': importer.import_units,
        'category': importer.import_category,
        'property': importer.import_property,
        'store': importer.import_supermarket,
        'food': importer.import_food,
        'conversion': importer.import_conversion,
    }
    return {datatype: steps[datatype]().to_dict() for datatype in DATATYPES}


def seed_units(space):
    created = []
    for name, plural, base_unit in EXTRA_UNITS:
        _, was_created = Unit.objects.get_or_create(
            space=space, name=name, defaults={'plural_name': plural, 'base_unit': base_unit},
        )
        if was_created:
            created.append(name)
    return created


def known_names(space):
    """Exact unit name or plural -> the unit name it resolves to."""
    known = {}
    for name, plural in Unit.objects.filter(space=space).values_list('name', 'plural_name'):
        known[name] = name
        if plural:
            known[plural] = name
    return known


def seed_automations(space, rules):
    created = updated = 0
    for r in rules:
        existing = Automation.objects.filter(space=space, type=r['type'], param_1__iexact=r['param_1'])
        if r['type'] == Automation.TRANSPOSE_WORDS:
            existing = existing.filter(param_2__iexact=r['param_2'] or '')
        existing = existing.first()
        name = f"{r['param_1']} → {r['param_2'] or ''}"[:128]
        if existing is None:
            Automation.objects.create(
                space=space, created_by=space.created_by, type=r['type'], name=name,
                param_1=r['param_1'], param_2=r['param_2'], param_3=r['param_3'],
            )
            created += 1
        elif (existing.param_2 or '') != (r['param_2'] or '') or (existing.param_3 or '') != (r['param_3'] or ''):
            existing.param_2 = r['param_2']
            existing.param_3 = r['param_3']
            existing.save()
            updated += 1
    return {'created': created, 'updated': updated}


def drop_shadowing_aliases(space):
    """Delete unit aliases whose source is itself a unit name or plural.

    An alias runs before the lookup, so "tsp -> TL" would hide the tsp unit
    seeded above. Such rows only exist when a unit was added after the alias,
    which is what happened when the English units replaced English aliases.
    """
    known = known_names(space)
    dropped = []
    for a in Automation.objects.filter(space=space, type=Automation.UNIT_ALIAS):
        # The lookup is exact and case-sensitive, so only the exact spelling
        # shadows. A plural pointing at its own unit ("Dosen -> Dose") is fine.
        resolves_to = known.get(a.param_1)
        if resolves_to is not None and resolves_to != a.param_2:
            dropped.append(f'{a.param_1} → {a.param_2}')
            a.delete()
    return dropped


def missing_targets(space, rules):
    """Alias targets that are not a unit in the space.

    Not fatal: the parser would create the target on first use, but without a
    base unit. It means a typo in the tables, or open data that renamed a unit.
    """
    units = set(Unit.objects.filter(space=space).values_list('name', flat=True))
    return sorted({r['param_2'] for r in rules if r['type'] == Automation.UNIT_ALIAS and r['param_2'] not in units})


space = target_space()
with scope(space=space), transaction.atomic():
    open_data = seed_open_data(space)
    units = seed_units(space)
    dropped = drop_shadowing_aliases(space)
    rules = build_rules(known_names(space))
    automations = seed_automations(space, rules)
    automations['dropped_shadowing'] = dropped
    automations['missing_targets'] = missing_targets(space, rules)

changed = (
    any(r['total_created'] or r['total_updated'] for r in open_data.values())
    or bool(units)
    or bool(automations['created'] or automations['updated'] or automations['dropped_shadowing'])
)
print('TANDOOR_BOOTSTRAP_RESULT ' + json.dumps({
    'changed': changed,
    'space': space.name,
    'open_data_version': OPEN_DATA_VERSION,
    'open_data': open_data,
    'units_created': units,
    'rules': len(rules),
    'automations': automations,
}, ensure_ascii=False))
